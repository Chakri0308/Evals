# RAG Lab configuration. Copy to .env (never commit .env). Everything is optional:
# with no keys at all the app runs locally (Ollama + local embeddings + Chroma).
# Most of these can also be changed live in the UI (gear icon); .env sets the starting defaults.

# ---------------------------------------------------------------- access policy (office / locked-down machines)
# false = never call any LLM. BM25 still works and answers by quoting the best sentences (with citations).
RAG_LAB_ALLOW_LLM=true
# false = never load or call embedding/reranker models. Semantic & hybrid panes then run a pre-flight
# check and report what is missing instead of failing.
RAG_LAB_ALLOW_EMBEDDINGS=true
# true = both of the above, plus no model downloads at all (sets HF_HUB_OFFLINE).
RAG_LAB_OFFLINE=false
# A switch set to false here is LOCKED: the UI shows it but cannot turn it back on.

# ---------------------------------------------------------------- defaults
# LLM provider: ollama | anthropic | openai | gemini | azure_openai | openai_compatible | extractive (no LLM)
LLM_PROVIDER=ollama
# Model for that provider ("" = the provider's own default)
LLM_MODEL=
# Embedding model as provider:model. Providers: local (sentence-transformers; also a folder path), ollama, openai, gemini
EMBEDDING_MODEL=local:BAAI/bge-small-en-v1.5
# Vector database: chroma | faiss | pgvector | pinecone | in_memory
VECTOR_STORE=chroma

# ---------------------------------------------------------------- LLM providers
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Azure OpenAI (model = deployment name)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
# Any OpenAI-compatible server: Groq, OpenRouter, Together, Mistral, DeepSeek, vLLM, LM Studio, a company gateway...
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
# Optional: OpenAI-compatible embeddings endpoint (defaults to api.openai.com)
OPENAI_EMBEDDINGS_BASE_URL=
# Optional: $ per 1M tokens for cost display, e.g. {"gemini-2.5-flash": [0.3, 2.5]}
LLM_PRICES=

# ---------------------------------------------------------------- vector databases
# Chroma: embedded in rag-lab/data/chroma by default; set CHROMA_HOST to use a Chroma server
CHROMA_HOST=
CHROMA_PORT=8000
# FAISS: flat (exact) or hnsw (approximate, for big corpora)
FAISS_INDEX=flat
# Postgres + pgvector
PGVECTOR_DSN=
# Pinecone (index is created on first use if missing; cosine metric)
PINECONE_API_KEY=
PINECONE_INDEX=rag-lab
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---------------------------------------------------------------- server / deployment
# Where caches, uploads, history and local vector DBs live (default: rag-lab/data)
RAG_LAB_DATA=
# Production host/port: read by prod.ps1 / prod.sh from the shell environment (set them there, e.g. $env:RAG_LAB_HOST)
RAG_LAB_HOST=127.0.0.1
RAG_LAB_PORT=8765
# Origins allowed to call the API directly (only the Vite dev server needs this)
RAG_LAB_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# DEBUG | INFO | WARNING | ERROR
RAG_LAB_LOG_LEVEL=INFO
# Load local models + index the sample at startup (false = faster start, first query is slower)
RAG_LAB_WARMUP=true
